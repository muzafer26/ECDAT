    <dependencies>
        <!-- Line 22: Direct declaration of Bouncy Castle cryptographic provider library -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.78.1</version>
        </dependency>
    </dependencies>
